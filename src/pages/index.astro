---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import GlassCard from '../components/GlassCard.astro';
import ProposalCard from '../components/ProposalCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import logo from '../assets/logo-cava.png';
import { proposte, ragioni, rete } from '../lib/proposte';
---

<BaseLayout
  title="Proposte per la Consulta dei Veneti nel Mondo · CAVA"
  description="Sette proposte per rafforzare i rapporti tra Veneto e Argentina. CAVA · Comitato delle Associazioni Venete dell'Argentina."
>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-logo">
      <Image src={logo} alt="Logo del CAVA · Comitato delle Associazioni Venete dell'Argentina" width={240} densities={[1, 2]} loading="eager" fetchpriority="high" />
    </div>
    <p class="hero-eyebrow">CAVA · Comitato delle Associazioni Venete dell'Argentina</p>
    <h1 id="hero-title">Proposte per la Consulta dei Veneti nel Mondo</h1>
    <p class="hero-sub">Sette proposte per rafforzare i rapporti tra Veneto e Argentina</p>
    <Button href="#proposte">
      Le sette proposte
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14m0 0-6-6m6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </Button>
  </section>

  <section class="section container" aria-labelledby="proposte">
    <SectionHeading id="proposte" eyebrow="In sintesi" title="Le sette proposte" />
    <ol class="cards" role="list">
      {proposte.map((p, i) => (
        <li data-reveal style={`--i:${i % 3}`}>
          <ProposalCard proposta={p} />
        </li>
      ))}
    </ol>
  </section>

  <section class="section container" aria-labelledby="ragioni">
    <SectionHeading id="ragioni" eyebrow="Proposta 2 · le ragioni" title="Perché puntare sull'Argentina" />
    <ul class="reasons" role="list">
      {ragioni.map((r, i) => (
        <li data-reveal style={`--i:${i % 3}`}>
          <GlassCard as="article" class="reason">
            <h3>{r.titolo}</h3>
            <p>{r.testo}</p>
          </GlassCard>
        </li>
      ))}
    </ul>
  </section>

  <section class="section container" aria-labelledby="rete">
    <SectionHeading
      id="rete"
      eyebrow="Mille chilometri per ritrovarci"
      title="La rete"
      lead="Le associazioni venete d'Argentina, in un paese nove volte più grande dell'Italia"
    />
    <ul class="stats" role="list">
      {rete.map((d, i) => (
        <li data-reveal style={`--i:${i}`}>
          <GlassCard class="stat">
            <p class="stat-value">{d.valore}</p>
            <p class="stat-label">{d.etichetta}</p>
            {d.confronto && <p class="stat-compare">{d.confronto}</p>}
          </GlassCard>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: var(--space-3);
    min-height: calc(100svh - var(--header-h));
    padding-block: var(--space-4);
  }
  .hero-logo {
    padding: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    border-radius: var(--radius);
    background: white;
    box-shadow: var(--glass-highlight), var(--glass-shadow);
  }
  .hero-logo img {
    width: clamp(140px, 10rem + 4vw, 240px);
    height: auto;
  }
  .hero-eyebrow {
    color: var(--c-oro);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero h1 {
    max-width: 14ch;
    font-size: var(--fs-h1);
  }
  .hero-sub {
    max-width: 32ch;
    color: var(--on-dark-muted);
    font-size: var(--fs-lead);
    line-height: 1.35;
  }

  /* Sections */
  .section {
    padding-block: var(--space-section) 0;
  }
  .section:last-of-type {
    padding-bottom: var(--space-section);
  }
  ol,
  ul {
    list-style: none;
    padding: 0;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-3);
  }

  .reasons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-3);
  }
  .cards li,
  .reasons li,
  .stats li {
    display: grid;
  }
  .reason {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }
  .reason h3 {
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
    color: var(--c-oro);
  }
  .reason p {
    color: var(--on-dark-muted);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-3);
  }
  .stat {
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }
  .stat-value {
    font-size: clamp(2.5rem, 2rem + 1.5vw, 3.25rem);
    font-weight: 800;
    white-space: nowrap;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--c-oro);
  }
  .stat-label {
    font-weight: 600;
    line-height: 1.4;
  }
  .stat-compare {
    color: var(--on-dark-muted);
    font-size: var(--fs-small);
  }
</style>
