---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlassCard from '../../components/GlassCard.astro';
import Chip from '../../components/Chip.astro';
import Button from '../../components/Button.astro';
import { proposte, url, type Proposta } from '../../lib/proposte';

export function getStaticPaths() {
  return proposte.map((p, i) => ({
    params: { slug: p.slug },
    props: { proposta: p, prev: proposte[i - 1], next: proposte[i + 1] },
  }));
}

interface Props {
  proposta: Proposta;
  prev?: Proposta;
  next?: Proposta;
}

const { proposta: p, prev, next } = Astro.props;
const totale = proposte.length;
---

<BaseLayout title={`${p.numero}. ${p.titolo} · CAVA`} description={p.sintesi} ambient={false}>
  <section class="hero" data-area={p.area} aria-labelledby="titolo">
    <div class="hero-bg" aria-hidden="true">
      {p.video && (
        <video
          class="hero-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={p.poster}
          data-src={p.video}
        ></video>
      )}
    </div>

    <div class="container hero-inner">
      <GlassCard class="hero-card">
        <div class="hero-meta">
          <Chip area={p.area} />
          <span>Proposta {p.numero} di {totale}</span>
        </div>
        <p class="hero-num" aria-hidden="true">{p.numero}</p>
        <h1 id="titolo">{p.titolo}</h1>
      </GlassCard>
    </div>
  </section>

  <article class="reading">
    <div class="reading-inner">
      <div class="reading-col">
        {p.testo.map((par) => <p data-reveal>{par}</p>)}
      </div>

      <nav class="pager" aria-label="Navigazione tra le proposte">
        {prev ? (
          <a class="pager-link" href={url(`proposte/${prev.slug}/`)} rel="prev">
            <span class="pager-dir">← Proposta {prev.numero}</span>
            <span class="pager-title">{prev.titolo}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="pager-link pager-link--next" href={url(`proposte/${next.slug}/`)} rel="next">
            <span class="pager-dir">Proposta {next.numero} →</span>
            <span class="pager-title">{next.titolo}</span>
          </a>
        ) : <span />}
      </nav>
      <div class="all">
        <Button href={url('/#proposte')} class="all-btn">Tutte le proposte</Button>
      </div>
    </div>
  </article>
</BaseLayout>

<script is:inline>
  // Load the hero video only when the user hasn't asked to save data; pause it with reduced motion.
  (() => {
    const v = document.querySelector('.hero-video[data-src]');
    if (!v || navigator.connection?.saveData) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    if (reduce.matches) v.removeAttribute('autoplay');
    v.src = v.dataset.src;
    reduce.addEventListener('change', (e) => (e.matches ? v.pause() : v.play()));
  })();
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: calc(100svh - var(--header-h));
    padding-block: var(--space-4);
    overflow: hidden;
    isolation: isolate;
  }
  /* Fallback / base: slowly moving gradient in the area color */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c-carbone);
  }
  .hero-bg::before {
    content: '';
    position: absolute;
    inset: -25%;
    background:
      radial-gradient(45% 50% at 25% 30%, color-mix(in srgb, var(--area) 85%, var(--c-crema)), transparent 70%),
      radial-gradient(35% 40% at 75% 65%, color-mix(in srgb, var(--c-oro-deco) 50%, transparent), transparent 70%),
      radial-gradient(55% 55% at 65% 20%, var(--area), transparent 70%);
    animation: hero-drift 24s var(--ease) infinite alternate;
  }
  [data-area='giovani'] .hero-bg::before {
    /* carbone on carbone would be invisible: lift it with a touch of green and bordò */
    background:
      radial-gradient(40% 45% at 25% 30%, color-mix(in srgb, var(--c-verde) 60%, transparent), transparent 70%),
      radial-gradient(35% 40% at 75% 65%, color-mix(in srgb, var(--c-oro-deco) 40%, transparent), transparent 70%),
      radial-gradient(50% 50% at 60% 20%, color-mix(in srgb, var(--c-bordo) 60%, transparent), transparent 70%);
  }
  @keyframes hero-drift {
    from {
      transform: translate3d(-4%, -2%, 0) rotate(0deg) scale(1);
    }
    to {
      transform: translate3d(4%, 3%, 0) rotate(8deg) scale(1.1);
    }
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Dark overlay so the text always reads */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--c-carbone) 80%, transparent),
      color-mix(in srgb, var(--c-carbone) 10%, transparent) 60%,
      color-mix(in srgb, var(--c-carbone) 30%, transparent)
    );
  }

  .hero-card {
    display: grid;
    gap: var(--space-2);
    max-width: 58rem;
    padding: var(--space-4) var(--space-3);
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    color: var(--on-dark-muted);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .hero-num {
    font-size: clamp(5rem, 3rem + 10vw, 11rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--c-oro);
  }
  .hero h1 {
    font-size: clamp(1.875rem, 1.2rem + 3.4vw, 4.5rem);
  }

  /* Reading section */
  .reading {
    background: var(--c-crema);
    color: var(--c-carbone);
    padding: var(--space-section) var(--gutter);
  }
  /* 65ch measured at the reading size; pager and button share the same column */
  .reading-inner {
    max-width: 65ch;
    margin-inline: auto;
    font-size: clamp(1.15rem, 1.05rem + 0.5vw, 1.45rem);
  }
  .reading-col {
    display: grid;
    gap: 1.25em;
    color: var(--c-testo);
    line-height: 1.65;
  }
  .reading-col p:first-child {
    color: var(--c-carbone);
  }

  .pager {
    margin-top: var(--space-section);
    font-size: var(--fs-body);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    border-top: 1px solid color-mix(in srgb, var(--c-carbone) 15%, transparent);
    padding-top: var(--space-3);
  }
  .pager-link {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0.75rem 0;
    text-decoration: none;
    color: var(--c-carbone);
    transition: transform 0.3s var(--ease);
  }
  .pager-link--next {
    text-align: right;
  }
  .pager-link:hover {
    transform: translateY(-2px);
  }
  .pager-dir {
    color: var(--c-bordo);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .pager-title {
    font-weight: 600;
    line-height: 1.3;
  }
  .reading :focus-visible {
    outline-color: var(--c-bordo);
  }
  .all {
    margin-top: var(--space-3);
    font-size: var(--fs-body);
    display: flex;
    justify-content: center;
  }
  .all-btn {
    background: var(--c-carbone);
    color: var(--c-crema);
  }
</style>
