---
import GlassCard from './GlassCard.astro';
import Chip from './Chip.astro';
import { url, type Proposta } from '../lib/proposte';

interface Props {
  proposta: Proposta;
}

const { proposta: p } = Astro.props;
---

<GlassCard as="a" href={url(`proposte/${p.slug}/`)} class="proposal-card" data-area={p.area}>
  <span class="num" aria-hidden="true">{p.numero}</span>
  <h3><span class="sr-only">Proposta {p.numero}: </span>{p.titolo}</h3>
  <Chip area={p.area} class="card-chip" />
</GlassCard>

<style>
  .proposal-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-2);
    min-height: 100%;
    color: var(--on-dark);
    text-decoration: none;
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--area) 55%, transparent),
      color-mix(in srgb, var(--c-crema) 5%, transparent) 70%
    );
    transition: transform 0.45s var(--ease);
  }
  /* Shine layer: animated with opacity only */
  .proposal-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      120% 80% at 0% 0%,
      color-mix(in srgb, var(--c-oro) 22%, transparent),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.45s var(--ease);
    pointer-events: none;
  }
  .proposal-card:hover,
  .proposal-card:focus-visible {
    transform: translateY(-6px);
  }
  .proposal-card:hover::after,
  .proposal-card:focus-visible::after {
    opacity: 1;
  }
  .proposal-card:focus-visible {
    outline-offset: 4px;
    border-radius: var(--radius);
  }
  .num {
    font-size: clamp(3.5rem, 2.8rem + 3vw, 5.5rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--c-oro);
  }
  h3 {
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .card-chip {
    justify-self: start;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
