---
import { Image } from 'astro:assets';
import logo from '../assets/logo-cava.png';
import { url } from '../lib/proposte';
---

<header class="site-header glass">
  <nav class="bar container" aria-label="Principale">
    <a href={url('/')} class="brand">
      <span class="logo-tile">
        <Image src={logo} alt="CAVA · Comitato delle Associazioni Venete dell'Argentina" height={40} densities={[1, 2]} loading="eager" />
      </span>
    </a>
    <a href={url('/#proposte')} class="nav-link">Tutte le proposte</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-radius: 0;
    border-width: 0 0 1px;
    background: color-mix(in srgb, var(--c-carbone) 72%, transparent);
    view-transition-name: site-header;
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header {
      background: var(--c-carbone);
    }
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
  .logo-tile {
    display: block;
    padding: 0.25rem 0.5rem;
    border-radius: 0.75rem;
    background: white;
  }
  .logo-tile img {
    height: 40px;
    width: auto;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--glass-border);
    font-weight: 600;
    font-size: var(--fs-small);
    text-decoration: none;
    transition: transform 0.3s var(--ease);
  }
  .nav-link:hover {
    transform: translateY(-1px);
  }
</style>
