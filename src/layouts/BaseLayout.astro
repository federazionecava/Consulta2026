---
import '../styles/global.css';
import fontRegular from '../assets/fonts/ZTNature-Regular.woff2?url';
import fontExtraBold from '../assets/fonts/ZTNature-ExtraBold.woff2?url';
import Header from '../components/Header.astro';
import { url } from '../lib/proposte';

interface Props {
  title: string;
  description: string;
  ambient?: boolean;
}

const { title, description, ambient = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('og.jpg'), Astro.site);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#17191D" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="CAVA · Comitato delle Associazioni Venete dell'Argentina" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" sizes="32x32" href={url('favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />

    <link rel="preload" href={fontRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontExtraBold} as="font" type="font/woff2" crossorigin />

    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Vai al contenuto</a>
    {ambient && <div class="ambient" aria-hidden="true"><span></span><span></span><span></span></div>}
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-name"><strong>CAVA</strong> · Comitato delle Associazioni Venete dell'Argentina</p>
        <p>Un ponte tra il Veneto e l'Argentina, da rafforzare insieme.</p>
        <!-- TODO: contatto reale -->
        <p class="footer-contact">[Nome e cognome] · [e-mail o contatto]</p>
      </div>
    </footer>

    <script is:inline>
      // Scroll reveal with short stagger (index set via --i in markup).
      (() => {
        const els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
  .site-footer {
    padding-block: var(--space-4);
    border-top: 1px solid var(--glass-border);
    background: var(--c-carbone);
    color: var(--on-dark-muted);
    font-size: var(--fs-small);
  }
  .footer-inner {
    display: grid;
    gap: 0.5rem;
  }
  .footer-name {
    color: var(--on-dark);
    font-size: var(--fs-body);
  }
  .footer-contact {
    color: var(--c-oro);
  }
</style>
